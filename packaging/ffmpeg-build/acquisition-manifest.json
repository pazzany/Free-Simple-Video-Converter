      "mingw-w64-ucrt-x86_64-pkgconf",
      "make",
      "diffutils"
    ],
    "immutable_retention": {
      "required": true,
      "location_kind": "project-controlled",
      "uri_prefix": "project://ffmpeg-build/"
    },
    "offline_install": {
      "command": "pacman -U",
      "forbidden_commands": [
        "pacman -S",
        "pacman -Sy",
        "pacman -Syu"
      ]
    }
  },
  "configure": {
    "flags": [
      "--target-os=mingw32",
      "--arch=x86_64",
      "--enable-gpl",
      "--enable-libx264",
      "--enable-libx265",
      "--enable-libvpx",
      "--enable-libsvtav1",
      "--enable-libopus",
      "--enable-nvenc",
      "--enable-libvpl",
      "--enable-amf",
      "--disable-ffplay",
      "--disable-doc"
    ]
  },
  "patches": [
